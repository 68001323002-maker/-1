<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Smart Home - ควบคุมไฟ</title>
  <style>
    body {
      font-family: sans-serif;
      background-color: #121212;
      color: #ffffff;
      display: flex;
      justify-content: center;
      padding: 20px;
      margin: 0;
    }
    .container {
      width: 100%;
      max-width: 400px;
    }
    h2 {
      text-align: center;
      margin-bottom: 24px;
    }
    .card {
      background-color: #1e1e1e;
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: 0.3s;
    }
    .card.active {
      background-color: #2c2511;
      border: 1px solid #ffd700;
    }
    .room-name {
      font-size: 18px;
      font-weight: bold;
    }
    .status {
      font-size: 14px;
      color: #aaa;
      margin-top: 4px;
    }
    /* สวิตช์เปิด-ปิด */
    .switch {
      position: relative;
      display: inline-block;
      width: 54px;
      height: 30px;
    }
    .switch input { opacity: 0; width: 0; height: 0; }
    .slider {
      position: absolute;
      cursor: pointer;
      top: 0; left: 0; right: 0; bottom: 0;
      background-color: #444;
      transition: .3s;
      border-radius: 30px;
    }
    .slider:before {
      position: absolute;
      content: "";
      height: 22px; width: 22px;
      left: 4px; bottom: 4px;
      background-color: white;
      transition: .3s;
      border-radius: 50%;
    }
    input:checked + .slider { background-color: #ffd700; }
    input:checked + .slider:before { transform: translateX(24px); }
    .brightness-box {
      background-color: #1e1e1e;
      border-radius: 16px;
      padding: 20px;
    }
    input[type=range] {
      width: 100%;
      margin-top: 10px;
      accent-color: #ffd700;
    }
  </style>
</head>
<body>
  <div class="container">
    <h2>💡 ควบคุมแสงสว่างในห้อง</h2>

    <div class="card" id="card1">
      <div>
        <div class="room-name">ไฟหลักกลางห้อง</div>
        <div class="status" id="status1">สถานะ: ปิดอยู่</div>
      </div>
      <label class="switch">
        <input type="checkbox" id="light1" onchange="toggleLight(1)">
        <span class="slider"></span>
      </label>
    </div>

    <div class="card" id="card2">
      <div>
        <div class="room-name">ไฟหัวเตียง</div>
        <div class="status" id="status2">สถานะ: ปิดอยู่</div>
      </div>
      <label class="switch">
        <input type="checkbox" id="light2" onchange="toggleLight(2)">
        <span class="slider"></span>
      </label>
    </div>

    <div class="brightness-box">
      <div class="room-name">ระดับความสว่าง: <span id="brightVal">50</span>%</div>
      <input type="range" min="10" max="100" value="50" oninput="updateBright(this.value)">
    </div>
  </div>

  <script>
    function toggleLight(num) {
      const isChecked = document.getElementById('light' + num).checked;
      const statusText = document.getElementById('status' + num);
      const card = document.getElementById('card' + num);
      
      if (isChecked) {
        statusText.innerText = 'สถานะ: เปิดอยู่';
        statusText.style.color = '#ffd700';
        card.classList.add('active');
      } else {
        statusText.innerText = 'สถานะ: ปิดอยู่';
        statusText.style.color = '#aaa';
        card.classList.remove('active');
      }
      // หมายเหตุ: หากมีบอร์ด IoT (เช่น ESP32) สามารถเพิ่มคำสั่ง fetch() ส่งค่าไปที่บอร์ดตรงนี้ได้
    }

    function updateBright(val) {
      document.getElementById('brightVal').innerText = val;
    }
  </script>
</body>
</html>
